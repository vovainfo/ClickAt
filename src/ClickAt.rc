#include <windows.h>
#include "resource.h"
#include "version.h"
#pragma code_page(65001)

1 RT_MANIFEST "ClickAt.manifest"
IDI_CLICKAT ICON "ClickAt.ico"

1 VERSIONINFO
 FILEVERSION CLICKAT_VERSION
 PRODUCTVERSION CLICKAT_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", L"ClickAt"
            VALUE "FileVersion", CLICKAT_VERSION_TEXT
            VALUE "LegalCopyright", L"© Владимир Гуменников"
            VALUE "ProductName", L"ClickAt"
            VALUE "ProductVersion", CLICKAT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
